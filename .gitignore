# Dependencies
node_modules/
frontend/node_modules/
mcp/node_modules/

# Build output
frontend/dist/

# Runtime state lives under ~/.signbridge (outside the repo), but ignore these
# in case anything is ever created locally.
data/
logs/
.signbridge/

# Secrets & credentials — never commit
.env
.env.*
# SignBridge has no .env-based configuration: operator knobs live in the tracked
# config.properties and provider API keys are entered in Settings and stored
# encrypted under ~/.signbridge. These patterns stay so a stray .env can never be
# committed.
#
# config.properties is deliberately NOT ignored: it holds no secret (there is no
# key-shaped setting in it at all — test/secretHygiene.test.js enforces that), so
# shipping the defaults means a fresh clone runs with no setup step. It used to be
# ignored with a config.properties.example beside it, which cost a copy step
# nobody should need and let the file people actually run drift, unreviewed, from
# the template. Local tweaks show in `git status`; `git update-index
# --skip-worktree config.properties` hides them if that is a nuisance.
.aws/
keys/
*.pem
*.key
*.crt
*.p12
*.pfx

# Local tooling (personal Claude Code settings, etc.)
.claude/settings.local.json

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp
*.log
