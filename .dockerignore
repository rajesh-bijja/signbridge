# Keep the build context small and free of secrets / local state.
node_modules
frontend/node_modules
mcp/node_modules
frontend/dist

# Runtime state and secrets must never be baked into the image.
data
keys
logs
.env
.env.*
.aws
# config.properties is NOT excluded: it is tracked, holds no secret (no key-shaped
# setting exists in it — see test/secretHygiene.test.js), and baking it is what
# lets the image run standalone. Compose bind-mounts the host's copy over it so an
# edit applies without a rebuild.
*.pem
*.key
*.crt
*.p12
*.pfx

# VCS / editor / OS
.git
.gitignore
.idea
.vscode
.DS_Store
*.log
